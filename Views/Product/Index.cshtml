@model IEnumerable<Shop_HW.Models.ProductModel>

@{
    ViewData["Title"] = "products";
}
<div>
    <h2 class="text-center">Список товарів</h2>

    <div>
        <table class="table table-striped text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Amount</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>
                            <a asp-controller="Product" asp-action="ViewProduct" asp-route-id="@product.Id">@product.Name</a>
                        </td>
                        <td>@product.Price.ToString("#.##") ₴</td>
                        <td>@product.Amount</td>
                        <td>@(product.Category != null ? product.Category.Name : "Без категорії")</td>
                        <td>@product.CreateDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            <img class="image-scale" height="50" src="@product.Image" alt="@product.Name">
                        </td>
                        <td>
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
