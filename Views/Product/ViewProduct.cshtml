@model Shop_HW.Models.ProductModel

@{
	ViewData["Title"] = Model?.Name ?? "Product";
}

<div class="container mt-4">
	<div class="row">
		<div class="col-md-6">
			@if (!string.IsNullOrEmpty(Model?.Image))
			{
				<img src="@Model.Image" alt="@Model.Name" class="img-fluid" />
			}
			else
			{
				<div class="border p-5 text-center text-muted">No image</div>
			}
		</div>
		<div class="col-md-6">
			<h2>@Model.Name</h2>
			<h4 class="text-success">@Model.Price.ToString("C")</h4>
			<p><strong>Category:</strong> @(Model.Category != null ? Model.Category.Name : "No category")</p>
			<p><strong>In stock:</strong> @Model.Amount</p>
			@if (Model.Amount == 0)
			{
				<div class="alert alert-danger">This product is out of stock.</div>
			}
			<p>@Model.Description</p>
			<p class="text-muted">Created: @Model.CreateDate.ToString("dd.MM.yyyy")</p>

			<div class="mt-3">
				<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to list</a>
			</div>
		</div>
	</div>
</div>
